# Local Docker Compose defaults. Copy to .env only when you want to override them.
POSTGRES_DB=routewise
POSTGRES_USER=routewise
POSTGRES_PASSWORD=routewise-local-only

# These ports avoid the other portfolio projects.
ROUTEWISE_FRONTEND_PORT=3003
ROUTEWISE_BACKEND_PORT=8004
ROUTEWISE_POSTGRES_PORT=5436

# Direct backend access is optional; the browser normally uses the frontend proxy.
ROUTEWISE_CORS_ORIGINS=["http://localhost:3003","http://127.0.0.1:3003"]

