ROUTEWISE_ENVIRONMENT=development
ROUTEWISE_DATABASE_URL=postgresql+asyncpg://routewise:routewise-local-only@localhost:5436/routewise
ROUTEWISE_CORS_ORIGINS=http://localhost:3003
ROUTEWISE_AUTO_CREATE_SCHEMA=true
ROUTEWISE_SQL_ECHO=false
ROUTEWISE_DATABASE_POOL_SIZE=5
ROUTEWISE_DATABASE_MAX_OVERFLOW=2
ROUTEWISE_DATABASE_POOL_TIMEOUT_SECONDS=30
ROUTEWISE_DATABASE_POOL_RECYCLE_SECONDS=300
ROUTEWISE_ROUTE_CACHE_ENTRIES=512
ROUTEWISE_MAX_ROUTE_RUNS=5000
